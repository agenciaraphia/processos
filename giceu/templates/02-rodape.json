      "html": "<style>:root{ --gx-blue:#7590c1;--gx-blue-deep:#4a6699;--gx-ink:#1b2540;--gx-mist:#e8edf6; --gx-graphite:#363334;--gx-paper:#fdfdfd;--gx-muted:#6b6768;--gx-line:#e6e3e3; --gx-display:'Newsreader',Georgia,serif;--gx-body:'Public Sans',system-ui,sans-serif; --gx-mono:'IBM Plex Mono',ui-monospace,monospace; --gx-ease:cubic-bezier(.23,1,.32,1);--gx-ease-io:cubic-bezier(.77,0,.175,1); --gx-radius:18px;}/* bloco de estilos: invisível no site, etiquetado no editor */.gx-assets{display:none!important}body.elementor-editor-active .gx-assets{display:flex!important;padding:6px 12px!important;background:repeating-linear-gradient(45deg,#e8edf6 0 8px,#fdfdfd 8px 16px)}body.elementor-editor-active .gx-assets::before{content:\"Estilos e interações GICEU (não remover)\";font:500 11px/1.4 var(--gx-mono);color:#4a6699;letter-spacing:.08em;text-transform:uppercase}@media (prefers-reduced-motion:no-preference){html{scroll-behavior:smooth}}body{background:var(--gx-paper);color:var(--gx-graphite);-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}::selection{background:var(--gx-blue);color:var(--gx-paper)}/* tipografia */.elementor-widget-text-editor p{margin:0 0 1em}.elementor-widget-text-editor p:last-child{margin-bottom:0}.elementor-widget-text-editor a{color:inherit;text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:.2em;transition:color .2s ease}.elementor-heading-title em{font-style:italic;color:var(--gx-blue)}.gx-on-blue .elementor-heading-title em{color:var(--gx-ink)}.gx-on-dark .elementor-heading-title em{color:var(--gx-blue)}.gx-balance .elementor-heading-title{text-wrap:balance}.gx-pretty p{text-wrap:pretty}.gx-eyebrow .elementor-heading-title{display:inline-flex;align-items:center;gap:.75em}.gx-eyebrow .elementor-heading-title::before{content:\"\";width:.7em;height:.7em;border-radius:50%;border:2px solid currentColor;flex:none}/* botões */.gx-btn .elementor-button{white-space:nowrap;transition:background-color .22s ease,color .22s ease,border-color .22s ease,transform .16s var(--gx-ease);-webkit-tap-highlight-color:transparent}.gx-btn .elementor-button:active{transform:scale(.97)}.gx-btn .elementor-button-text::after{content:\"\\2192\";display:inline-block;margin-left:.55em;transition:transform .25s var(--gx-ease)}.gx-btn.gx-btn--plain .elementor-button-text::after{content:none}@media (hover:hover) and (pointer:fine){.gx-btn .elementor-button:hover .elementor-button-text::after{transform:translateX(4px)}}.gx-btn .elementor-button:focus-visible,.gx-focus a:focus-visible,.gx-legend button:focus-visible{outline:2px solid var(--gx-blue-deep);outline-offset:3px}.gx-on-blue .gx-btn .elementor-button:focus-visible,.gx-on-dark .gx-btn .elementor-button:focus-visible{outline-color:var(--gx-paper)}/* cartões */.gx-card{transition:transform .35s var(--gx-ease),box-shadow .35s var(--gx-ease),border-color .25s ease;border:1px solid var(--gx-line)}@media (hover:hover) and (pointer:fine){.gx-card:hover{transform:translateY(-4px);box-shadow:0 18px 40px -24px rgba(27,37,64,.35);border-color:var(--gx-blue)}}/* selos de linha, como num mapa de transporte */.gx-badge{display:inline-flex;align-items:center;justify-content:center;width:52px;height:52px;border-radius:50%;font:600 15px/1 var(--gx-mono);letter-spacing:.02em;color:var(--gx-paper);background:var(--gx-blue);box-shadow:0 0 0 5px var(--gx-paper)}.gx-badge--l2{background:var(--gx-graphite)}.gx-badge--fm{background:var(--gx-paper);color:var(--gx-blue-deep);box-shadow:inset 0 0 0 3px var(--gx-blue),0 0 0 5px var(--gx-paper)}.gx-mist .gx-badge{box-shadow:0 0 0 5px var(--gx-mist)}.gx-mist .gx-badge--fm{box-shadow:inset 0 0 0 3px var(--gx-blue),0 0 0 5px var(--gx-mist)}/* etiquetas */.gx-tags{display:flex;flex-wrap:wrap;gap:10px;margin:0;padding:0;list-style:none}.gx-tags li{font:500 14px/1 var(--gx-body);padding:11px 16px;border-radius:999px;border:1px solid var(--gx-line);background:var(--gx-paper);color:var(--gx-graphite)}/* fatos em lista de definição */.gx-facts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0;margin:0;border-top:1px solid var(--gx-line)}.gx-facts div{padding:18px 18px 18px 0;border-bottom:1px solid var(--gx-line)}.gx-facts dt{font:500 11.5px/1.3 var(--gx-mono);letter-spacing:.12em;text-transform:uppercase;color:var(--gx-blue-deep);margin:0 0 6px}.gx-facts dd{margin:0;font:400 22px/1.25 var(--gx-display);color:var(--gx-graphite)}/* entrada ao rolar: sobe 18px e aparece, com cascata curta */html.gx-ready .gx-reveal{opacity:0;transform:translate3d(0,18px,0);transition:opacity .7s var(--gx-ease) var(--gx-delay,0ms),transform .9s var(--gx-ease) var(--gx-delay,0ms)}html.gx-ready .gx-reveal.is-in{opacity:1;transform:none}/* traçados que se desenham */.gx-path{stroke-dasharray:1;stroke-dashoffset:0}html.gx-ready .gx-draw .gx-path{stroke-dashoffset:1;transition:stroke-dashoffset 1.6s var(--gx-ease-io) var(--gx-pd,0ms)}html.gx-ready .gx-draw.is-in .gx-path{stroke-dashoffset:0}html.gx-ready .gx-draw .gx-stn{opacity:0;transform:scale(.6);transition:opacity .4s ease var(--d,0ms),transform .5s var(--gx-ease) var(--d,0ms)}html.gx-ready .gx-draw.is-in .gx-stn{opacity:1;transform:none}.gx-stn{transform-box:fill-box;transform-origin:center}@media (prefers-reduced-motion:reduce){ html.gx-ready .gx-reveal{transform:none;transition:opacity .4s ease} html.gx-ready .gx-draw .gx-path{stroke-dashoffset:0;transition:none} html.gx-ready .gx-draw .gx-stn{transform:none;transition:opacity .4s ease} .gx-btn .elementor-button,.gx-card{transition:background-color .2s ease,color .2s ease,border-color .2s ease} .gx-card:hover{transform:none!important}}.gx-footer a{color:inherit}.gx-footer .elementor-widget-text-editor a{text-decoration-color:rgba(253,253,253,.35);transition:text-decoration-color .2s ease,color .2s ease}.gx-footer .elementor-widget-text-editor a:hover{text-decoration-color:var(--gx-blue);color:var(--gx-paper)}.gx-footer .gx-label .elementor-heading-title{color:var(--gx-blue)!important}.gx-footer .elementor-social-icon{transition:background-color .2s ease,transform .16s var(--gx-ease)}.gx-footer .elementor-social-icon:hover{background:var(--gx-blue)!important}.gx-footer .elementor-social-icon:active{transform:scale(.94)}/* o mapa do site é uma linha de metrô */.gx-metro{position:relative}.gx-metro ul{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(8,minmax(0,1fr));position:relative}.gx-metro ul::before{content:\"\";position:absolute;left:0;right:0;top:11px;height:6px;border-radius:6px;background:var(--gx-blue);transform-origin:left center}.gx-metro li{position:relative;z-index:1}.gx-metro a{display:flex;flex-direction:column;align-items:flex-start;gap:16px;text-decoration:none;color:rgba(253,253,253,.72);padding-bottom:4px;transition:color .2s ease}.gx-metro .gx-dot{position:relative;z-index:1;flex:none;width:28px;height:28px;border-radius:50%;background:var(--gx-graphite);border:5px solid var(--gx-paper);transition:transform .3s var(--gx-ease),background-color .2s ease}.gx-metro .gx-name{font:400 19px/1.2 var(--gx-display)}.gx-metro .gx-name small{display:block;font:500 10.5px/1.4 var(--gx-mono);letter-spacing:.14em;text-transform:uppercase;color:rgba(253,253,253,.55);margin-top:4px}.gx-metro a:hover,.gx-metro a:focus-visible{color:var(--gx-paper)}.gx-metro a:hover .gx-dot,.gx-metro a:focus-visible .gx-dot{transform:scale(1.18);background:var(--gx-blue)}.gx-metro a:focus-visible{outline:2px solid var(--gx-paper);outline-offset:6px;border-radius:6px}html.gx-ready .gx-metro.gx-draw ul::before{transform:scaleX(0);transition:transform 1.4s var(--gx-ease-io)}html.gx-ready .gx-metro.gx-draw.is-in ul::before{transform:none}html.gx-ready .gx-metro.gx-draw li{opacity:0;transform:translateY(8px);transition:opacity .45s ease calc(var(--i)*90ms + 200ms),transform .6s var(--gx-ease) calc(var(--i)*90ms + 200ms)}html.gx-ready .gx-metro.gx-draw.is-in li{opacity:1;transform:none}@media (max-width:1024px){ .gx-metro ul{grid-template-columns:repeat(4,minmax(0,1fr));row-gap:36px} .gx-metro ul::before{display:none} .gx-metro li::before{content:\"\";position:absolute;left:0;right:0;top:11px;height:6px;background:var(--gx-blue)} .gx-metro li:nth-child(4n)::before{right:auto;width:28px}}@media (max-width:767px){ .gx-metro ul{grid-template-columns:1fr;row-gap:0} .gx-metro li::before{left:11px;right:auto;top:0;bottom:0;width:6px;height:auto} .gx-metro li:first-child::before{top:14px}.gx-metro li:last-child::before{bottom:auto;height:14px} .gx-metro li:nth-child(4n)::before{width:6px} .gx-metro a{flex-direction:row;align-items:center;gap:18px;padding:8px 0} .gx-metro .gx-name small{display:inline;margin:0 0 0 8px}}.gx-totop .elementor-button-text::after{content:\"\\2191\"!important}@media (hover:hover) and (pointer:fine){.gx-totop .elementor-button:hover .elementor-button-text::after{transform:translateY(-3px)!important}}@media (prefers-reduced-motion:reduce){html.gx-ready .gx-metro.gx-draw li{transform:none}html.gx-ready .gx-metro.gx-draw ul::before{transform:none;transition:none}}</style>\n<script>(function(){\n if(window.__gx)return;window.__gx=1;\n var d=document,root=d.documentElement;\n function ready(fn){d.readyState!=='loading'?fn():d.addEventListener('DOMContentLoaded',fn)}\n var editor=/elementor-editor-active/.test(d.body?d.body.className:'')||/elementor-preview/.test(location.search);\n function onScroll(){d.body&&d.body.classList.toggle('gx-scrolled',window.scrollY>40)}\n window.addEventListener('scroll',onScroll,{passive:true});ready(onScroll);\n ready(function(){\n  // destaque das linhas no mapa ao passar o mouse na legenda\n  d.querySelectorAll('[data-gx-hl]').forEach(function(b){\n   var m=b.closest('.gx-map-wrap');m=m&&m.querySelector('.gx-map');if(!m)return;\n   function on(){m.setAttribute('data-hl',b.getAttribute('data-gx-hl'))}\n   function off(){m.removeAttribute('data-hl')}\n   b.addEventListener('mouseenter',on);b.addEventListener('focus',on);\n   b.addEventListener('mouseleave',off);b.addEventListener('blur',off);\n  });\n  // índice para cascatas\n  d.querySelectorAll('.gx-stagger').forEach(function(p){\n   p.querySelectorAll('.gx-reveal').forEach(function(k,i){k.style.setProperty('--gx-delay',Math.min(i*70,420)+'ms')});\n  });\n  d.querySelectorAll('.gx-metro li,.gx-wave span').forEach(function(li){li.style.setProperty('--i',[].indexOf.call(li.parentNode.children,li))});\n  var all=d.querySelectorAll('.gx-reveal,.gx-draw'),live=d.querySelectorAll('.gx-live');\n  if(editor||!('IntersectionObserver' in window)){\n   all.forEach(function(e){e.classList.add('is-in')});live.forEach(function(e){e.classList.add('is-playing')});return;\n  }\n  root.classList.add('gx-ready');\n  var io=new IntersectionObserver(function(es){es.forEach(function(e){\n   if(e.isIntersecting){e.target.classList.add('is-in');io.unobserve(e.target)}\n  })},{rootMargin:'0px 0px -8% 0px',threshold:.12});\n  all.forEach(function(e){io.observe(e)});\n  // animações contínuas só rodam quando visíveis\n  var lo=new IntersectionObserver(function(es){es.forEach(function(e){\n   var el=e.target;\n   if(e.isIntersecting){clearTimeout(el.__gxT);el.__gxT=setTimeout(function(){el.classList.add('is-playing')},el.classList.contains('gx-wave')?1400:0)}\n   else{clearTimeout(el.__gxT);el.classList.remove('is-playing')}\n  })},{threshold:0});\n  live.forEach(function(e){lo.observe(e)});\n });\n})();</script>"
